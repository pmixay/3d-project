[Unit]
Description=Hercules AI print failure monitor
Documentation=file://@DIR@/README.md
After=network-online.target
Wants=network-online.target
# Crash-loop guard: at most 10 restarts per 5 minutes, then systemd gives up and logs it.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
SupplementaryGroups=video
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
# Overrides without editing files, e.g.:
# Environment=HERCULES_MOONRAKER__URL=http://192.168.1.50:7125
ExecStart=@DIR@/.venv/bin/python -m hercules --config config/hercules.local.toml run
Restart=always
RestartSec=5
# The monitor must never compete with Klipper for the CPU. These matter if it
# ever runs on the printer host itself; on a separate PC they are harmless.
Nice=10
CPUWeight=20
IOSchedulingClass=idle
MemoryMax=1500M
# Logs: journald (journalctl -u hercules) + rotating file in state/logs/
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
